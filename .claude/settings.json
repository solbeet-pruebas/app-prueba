{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "solbeet": {
      "source": {
        "source": "github",
        "repo": "solbeet/solbeet-plugin",
        "ref": "v0.1.2"
      }
    }
  },
  "enabledPlugins": {
    "solbeet@solbeet": true
  },
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright*)",
      "Bash(uv run pytest*)",
      "Bash(uv run alembic current*)",
      "Bash(uv run alembic history*)",
      "Bash(uv run alembic revision *)",
      "Bash(uv run alembic upgrade head)",
      "Bash(npm ci)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker build *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(uv run alembic downgrade*)",
      "Bash(docker compose down*)",
      "Bash(copier *)",
      "Bash(git rebase*)",
      "Bash(git reset*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Bash(cat *.env)",
      "Bash(cat */.env)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(kubectl *)",
      "Bash(helm *)"
    ]
  }
}
