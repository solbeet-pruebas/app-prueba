# Copiar a backend/.env para desarrollo local fuera de Docker. Solo nombres y valores
# de ejemplo locales: los valores reales los inyecta la plataforma de deploy.
# Descripción, tipo y default de cada variable: docs/configuracion.md

# Obligatoria en producción
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Opcionales
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=[]
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=app-prueba-api
